# GitHub OAuth App client ID (Device Flow). Create at https://github.com/settings/developers
# Enable Device Flow on the OAuth App. Do not commit real values — copy to .env.local.
VITE_GITHUB_CLIENT_ID=

# Optional: absolute URL of an OAuth proxy for production (GitHub Pages cannot proxy POSTs).
# Local `npm run dev` uses the built-in /github-oauth middleware instead.
# After `npx convex deploy`, use your Convex HTTP site URL + /github-oauth:
# VITE_GITHUB_OAUTH_PROXY=https://your-deployment.convex.site/github-oauth
