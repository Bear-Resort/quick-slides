# GitHub OAuth App client ID (Device Flow). Create at https://github.com/settings/developers
# Enable Device Flow on the OAuth App. Do not commit real values — copy to .env.local.
VITE_GITHUB_CLIENT_ID=

# Convex client URL (from `npx convex dev` / dashboard). Required for quota + admin APIs.
# Example: https://your-deployment.convex.cloud
VITE_CONVEX_URL=

# Convex HTTP site URL (used for GitHub OAuth proxy + selectable-text PDF export).
# Example: https://your-deployment.convex.site
VITE_CONVEX_SITE_URL=

# Optional: absolute URL of an OAuth proxy for production (GitHub Pages cannot proxy POSTs).
# Local `npm run dev` uses the built-in /github-oauth middleware instead.
# After `npx convex deploy`, use your Convex HTTP site URL + /github-oauth:
# VITE_GITHUB_OAUTH_PROXY=https://your-deployment.convex.site/github-oauth

# --- Convex dashboard env (npx convex env set …) for selectable PDF export ---
# BROWSERLESS_API_TOKEN=your_browserless_token
# Optional override:
# BROWSERLESS_PDF_URL=https://production-sfo.browserless.io/pdf
